{
  "name": "byob-wine-vote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "password:hash": "node scripts/password-hash.mjs",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:existing": "npm run build && node scripts/deploy-existing.mjs",
    "deploy:existing:check": "npm run build && node scripts/deploy-existing.mjs --dry-run"
  },
  "dependencies": {
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261101.0-beta",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.156.1"
  }
}
