{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byob-wine-vote",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/10 * * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "byob-wine-vote",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "byob-wine-photos" }],
  "durable_objects": { "bindings": [{ "name": "PASSWORD_VERIFIER", "class_name": "PasswordVerifier" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordVerifier"] }]
}
